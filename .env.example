# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===== OpenRouter AI Configuration =====
# Dapatkan API Key di https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model AI yang digunakan (opsional)
# Default: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# URL aplikasi (untuk referer header OpenRouter)
APP_URL=https://github.com/agent-bkpsdm-telegram

# ===== API Backend (menggantikan koneksi MySQL langsung) =====
# URL backend API yang menyediakan data jadwal & tugas
API_BASE_URL=https://bkpsdm.surabaya.go.id/api/agent-telegram

# Autentikasi API — bot akan auto-login dengan kredensial ini
API_USERNAME=admin_bkpsdm
API_PASSWORD=BkpsdmSby@2024!

# ===== Security =====
# Chat ID yang diizinkan menggunakan bot (pisahkan dengan koma jika lebih dari satu)
ALLOWED_CHAT_IDS=

# ===== WhatsApp (bkpsdm-wa — index-wa.js) =====
# Nomor WA yang diizinkan (format internasional tanpa +, pisahkan dengan koma)
# Contoh: WA_ALLOWED_NUMBERS=6281234567890,6289876543210
# Kosongkan = mode publik (SEMUA nomor bisa pakai) — tidak disarankan!
WA_ALLOWED_NUMBERS=

# ===== TEKO-CAK (automated-tekocak) =====
TEKOCAK_URL=https://teko-cak.surabaya.go.id
TEKOCAK_USERNAME=username_tekocak
TEKOCAK_PASSWORD=password_tekocak
TEKOCAK_TAHUN=2026
TEKOCAK_HEADLESS=true
# Key AES-256 untuk master-pegawai.csv.enc (daftar NIP)
CSV_ENCRYPT_KEY=key_rahasia_anda

# ===== KantorKu WFH (automated-kantorku-wfh) =====
KANTORKU_NIK=nomor_nik_anda
KANTORKU_PASSWORD=password_kantorku
# Key AES-256 untuk pegawai bkd non prigen.csv.enc
KANTORKU_CSV_KEY=key_rahasia_kantorku

# ===== eSurat / agenda undangan (automated-esurat) =====
# Akun layanan KantorKu — login Sanctum, token berlaku ~2 jam, rate limit 60 req/menit
ESURAT_BASE_URL=https://kantorku.surabaya.go.id
ESURAT_LOGIN_URL=https://kantorku.surabaya.go.id/api/login
ESURAT_AGENDA_URL=https://kantorku.surabaya.go.id/api/integrasi/esurat-agenda
ESURAT_USERNAME=username_esurat
ESURAT_PASSWORD=password_esurat
# opsional (ms)
ESURAT_TIMEOUT_MS=30000

# Reminder undangan — kirim ~1 jam sebelum acara. Boleh BEBERAPA unit, dipisah koma.
ESURAT_REMINDER_UNIT=SEKRETARIAT,SUB BAGIAN KEUANGAN
ESURAT_REMINDER_WINDOW_MIN=60
# Unit tujuan DEFAULT untuk perintah bot "undangan esurat ..." (kalau pesan tidak
# menyebut unit). Pesan boleh menyebut unit lain, mis. "undangan esurat keuangan",
# atau "tanpa filter"/"semua unit". Daftar alias: automated-esurat/units.js
# (sekretariat, keuangan, umum, pengadaan, mutasi, penilaian kinerja, bkpsdm, ...)
ESURAT_UNIT_FILTER=SEKRETARIAT
# opsional: chat tujuan reminder (default: ALLOWED_CHAT_IDS pertama)
# ESURAT_REMINDER_CHAT_ID=
# opsional: batasi penerima WA ke tag tertentu (mis. adrian saja); kosong = semua
# ESURAT_REMINDER_WA_TO=adrian

# ===== Tag nama kontak WA (tag:nomor, pisah koma) =====
# Dipakai reminder eSurat untuk menandai penerima. Kosong → fallback WA_ALLOWED_NUMBERS.
WA_CONTACTS=adrian:6281216435394,nancy:6282244649994
