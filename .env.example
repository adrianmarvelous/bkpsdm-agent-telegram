# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===== OpenRouter AI Configuration =====
# Dapatkan API Key di https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model AI yang digunakan (opsional)
# Default: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# URL aplikasi (untuk referer header OpenRouter)
APP_URL=https://github.com/agent-bkpsdm-telegram

# ===== API Backend (menggantikan koneksi MySQL langsung) =====
# URL backend API yang menyediakan data jadwal & tugas
API_BASE_URL=https://bkpsdm.surabaya.go.id/api/agent-telegram

# Autentikasi API — bot akan auto-login dengan kredensial ini
API_USERNAME=admin_bkpsdm
API_PASSWORD=BkpsdmSby@2024!

# ===== Security =====
# Chat ID yang diizinkan menggunakan bot (pisahkan dengan koma jika lebih dari satu)
ALLOWED_CHAT_IDS=

# ===== WhatsApp (bkpsdm-wa — index-wa.js) =====
# Nomor WA yang diizinkan (format internasional tanpa +, pisahkan dengan koma)
# Contoh: WA_ALLOWED_NUMBERS=6281234567890,6289876543210
# Kosongkan = mode publik (SEMUA nomor bisa pakai) — tidak disarankan!
WA_ALLOWED_NUMBERS=

# ===== TEKO-CAK (automated-tekocak) =====
TEKOCAK_URL=https://teko-cak.surabaya.go.id
TEKOCAK_USERNAME=username_tekocak
TEKOCAK_PASSWORD=password_tekocak
TEKOCAK_TAHUN=2026
TEKOCAK_HEADLESS=true
# Key AES-256 untuk master-pegawai.csv.enc (daftar NIP)
CSV_ENCRYPT_KEY=key_rahasia_anda

# ===== KantorKu WFH (automated-kantorku-wfh) =====
KANTORKU_NIK=nomor_nik_anda
KANTORKU_PASSWORD=password_kantorku
# Key AES-256 untuk pegawai bkd non prigen.csv.enc
KANTORKU_CSV_KEY=key_rahasia_kantorku
